DB_PASSWORD=change-me-long-random-password
MYSQL_ROOT_PASSWORD=change-me-root-password

AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=multimodalAgent-qwen2.5-7b-ft:latest
AI_MAX_TOKENS=320
CHAT_HISTORY_LIMIT=6
RAG_TOP_K=3
RAG_FAST_MODE=true
RAG_PLANNER_ENABLED=false
RAG_REVIEW_ENABLED=false
RAG_MAX_QUERIES=1
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Enable only when an external MCP client must call /mcp directly.
MCP_SERVER_ENABLED=false
MCP_SERVER_TOKEN=change-me-mcp-token

# Local demo accounts are disabled by default. Enable only for a dev profile.
SEED_DEMO_USERS=false
MULTIMODAL_AGENT_ADMIN_PASSWORD=change-me-admin-password
MULTIMODAL_AGENT_STUDENT_PASSWORD=change-me-student-password
